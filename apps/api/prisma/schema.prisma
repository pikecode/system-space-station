generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserType {
  EMPLOYEE
  PARTNER
}

enum DepartmentType {
  GOVERNANCE
  HQ
  CENTER
  DIRECT
  MARKET
  DIVISION
}

enum DeptStatus {
  ACTIVE
  INACTIVE
}

enum PositionStatus {
  ACTIVE
  INACTIVE
}

enum UserRole {
  ADMIN
  HEAD
  MEMBER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum RiskTolerance {
  CONSERVATIVE
  MODERATE
  AGGRESSIVE
  SPECULATIVE
}

enum Gender {
  MALE
  FEMALE
  UNKNOWN
}

enum CustomerSource {
  REFERRAL
  SELF_DEVELOPED
  ACTIVITY
  ONLINE
  OTHER
}

enum CustomerStatus {
  PROSPECT
  ACTIVE_MEMBER
  ACTIVE
  INACTIVE
}

enum RegistrationSource {
  SELF
  PARTNER
  ADMIN
}

enum MemberLevelStatus {
  ACTIVE
  INACTIVE
}

enum MembershipStatus {
  PENDING
  APPROVED
  PAID
  REJECTED
  EXPIRED
  REFUND_PENDING
  REFUNDED
}

enum CommissionEntry {
  EARNING
  REVERSAL
}

enum CommissionRole {
  MEMBER
  DEPT_HEAD
  MARKET_HEAD
  COMPANY
  REFERRAL
}

enum CommissionStatus {
  PENDING
  PENDING_PAYMENT
  SETTLED
}

enum PeriodStatus {
  OPEN
  PENDING_PAYMENT
  SETTLED
}

enum SchedulerStatus {
  SUCCESS
  FAILED
  SKIPPED
}

enum InvestmentProductStatus {
  DRAFT
  ACTIVE
  CLOSED
  ARCHIVED
}

enum CustomerInvestmentStatus {
  ACTIVE
  EXITED
  CANCELLED
}

enum ProductYieldStatus {
  DRAFT
  CONFIRMED
  SETTLED
}

enum CustomerProfitStatus {
  GENERATED
  SETTLED
}

enum ProfitShareConfigStatus {
  ACTIVE
  INACTIVE
}

enum ProfitShareReceiverType {
  CUSTOMER
  DEPARTMENT
  CONTRACTED_USER
  CREATED_USER
  COMPANY
}

model Department {
  id                String             @id @default(cuid())
  name              String
  code              String?            @unique
  parentId          String?
  parent            Department?        @relation("DepartmentHierarchy", fields: [parentId], references: [id])
  children          Department[]       @relation("DepartmentHierarchy")
  type              DepartmentType
  headId            String?            @unique
  head              User?              @relation("DepartmentHead", fields: [headId], references: [id])
  sort              Int                @default(0)
  description       String?
  province          String?
  city              String?
  district          String?
  addressDetail     String?
  status            DeptStatus         @default(ACTIVE)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  users             User[]             @relation("DepartmentUsers")
  customers         Customer[]
  commissionRecords CommissionRecord[] @relation("CommissionDepartment")

  @@index([parentId])
  @@index([type])
}

model Position {
  id        String         @id @default(cuid())
  name      String
  sort      Int            @default(0)
  status    PositionStatus @default(ACTIVE)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  users     User[]
}

model User {
  id                        String             @id @default(cuid())
  name                      String
  username                  String?            @unique
  phone                     String             @unique
  employeeNo                String?            @unique
  userType                  UserType           @default(EMPLOYEE)
  hasLicense                Boolean            @default(false)
  licenseNo                 String?
  shareCode                 String?            @unique
  gender                    Gender?
  birthDate                 DateTime?
  alternatePhone            String?
  wechat                    String?
  wechatOpenId              String?            @unique
  province                  String?
  city                      String?
  district                  String?
  addressDetail             String?
  idCardEncrypted           String?
  idCardHash                String?            @unique
  idCardMasked              String?
  email                     String?
  avatar                    String?
  positionId                String?
  position                  Position?          @relation(fields: [positionId], references: [id])
  passwordHash              String?
  role                      UserRole           @default(MEMBER)
  departmentId              String?
  department                Department?        @relation("DepartmentUsers", fields: [departmentId], references: [id])
  headOf                    Department?        @relation("DepartmentHead")
  authVersion               Int                @default(1)
  status                    UserStatus         @default(ACTIVE)
  lastLoginAt               DateTime?
  createdAt                 DateTime           @default(now())
  updatedAt                 DateTime           @updatedAt
  customers                 Customer[]         @relation("AssignedCustomers")
  createdCustomers          Customer[]         @relation("CreatedCustomers")
  referredCustomers         Customer[]         @relation("ReferredCustomers")
  submittedMemberships      Membership[]       @relation("SubmittedMemberships")
  reviewedMemberships       Membership[]       @relation("ReviewedMemberships")
  refundReviewedMemberships Membership[]       @relation("RefundReviewedMemberships")
  receivedCommissions       CommissionRecord[]
}

model MemberLevel {
  id          String            @id @default(cuid())
  name        String
  description String?
  sort        Int               @default(0)
  status      MemberLevelStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  memberships Membership[]
}

model Customer {
  id                     String                 @id @default(cuid())
  customerType           CustomerType
  name                   String
  phone                  String
  source                 CustomerSource
  tags                   String?
  notes                  String?
  wechat                 String?
  gender                 Gender?
  birthday               DateTime?
  address                String?
  creditCode             String?
  industry               String?
  contactName            String?
  contactPhone           String?
  legalPerson            String?
  registeredCapital      String?
  idCard                 String?
  riskTolerance          RiskTolerance?
  isAccreditedInvestor   Boolean                @default(false)
  investmentAmount       Decimal?               @db.Decimal(12, 2)
  customerNo             String?                @unique
  customerPasswordHash   String?
  memberActivatedAt      DateTime?
  customerLastLoginAt    DateTime?
  assignedTo             String
  assignedUser           User                   @relation("AssignedCustomers", fields: [assignedTo], references: [id])
  createdBy              String
  creator                User                   @relation("CreatedCustomers", fields: [createdBy], references: [id])
  referredBy             String?
  referrer               User?                  @relation("ReferredCustomers", fields: [referredBy], references: [id])
  referrerEmployeeNo     String?
  referrerDepartmentId   String?
  contractedBy           String?
  contractedEmployeeNo   String?
  contractedDepartmentId String?
  contractedAt           DateTime?
  departmentId           String
  department             Department             @relation(fields: [departmentId], references: [id])
  status                 CustomerStatus         @default(PROSPECT)
  registrationSource     RegistrationSource     @default(PARTNER)
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  memberships            Membership[]
  investments            CustomerInvestment[]
  profitRecords          CustomerProfitRecord[]

  @@index([assignedTo])
  @@index([departmentId])
  @@index([status])
  @@index([contractedEmployeeNo])
}

model Membership {
  id                     String             @id @default(cuid())
  memberNo               String             @unique
  customerId             String
  customer               Customer           @relation(fields: [customerId], references: [id])
  memberLevelId          String?
  memberLevel            MemberLevel?       @relation(fields: [memberLevelId], references: [id])
  fee                    Decimal            @db.Decimal(10, 2)
  startDate              DateTime
  endDate                DateTime
  paidAt                 DateTime?
  paidAmount             Decimal?           @db.Decimal(12, 2)
  paymentConfirmedBy     String?
  status                 MembershipStatus   @default(PENDING)
  submittedBy            String
  submitter              User               @relation("SubmittedMemberships", fields: [submittedBy], references: [id])
  submittedDepartmentId  String?
  submittedAssignedTo    String?
  reviewedBy             String?
  reviewer               User?              @relation("ReviewedMemberships", fields: [reviewedBy], references: [id])
  reviewedAt             DateTime?
  approvedDepartmentId   String?
  approvedAssignedTo     String?
  contractedBy           String?
  contractedEmployeeNo   String?
  contractedDepartmentId String?
  reviewNote             String?
  refundReason           String?
  refundReviewedBy       String?
  refundReviewer         User?              @relation("RefundReviewedMemberships", fields: [refundReviewedBy], references: [id])
  refundReviewedAt       DateTime?
  refundAt               DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  commissionRecords      CommissionRecord[]

  @@index([customerId])
  @@index([status, endDate])
  @@index([submittedBy])
  @@index([submittedDepartmentId])
  @@index([approvedDepartmentId])
}

model CommissionConfig {
  id              String   @id @default(cuid())
  memberRatio     Decimal  @db.Decimal(5, 2)
  deptHeadRatio   Decimal  @db.Decimal(5, 2)
  marketHeadRatio Decimal  @db.Decimal(5, 2)
  companyRatio    Decimal  @db.Decimal(5, 2)
  referralRatio   Decimal  @default(30) @db.Decimal(5, 2)
  settlementDays  Int      @default(15)
  effectiveFrom   DateTime
  remark          String?
  createdBy       String
  createdAt       DateTime @default(now())

  @@index([effectiveFrom])
}

model CommissionRecord {
  id               String             @id @default(cuid())
  businessKey      String             @unique
  membershipId     String
  membership       Membership         @relation(fields: [membershipId], references: [id])
  departmentId     String?
  department       Department?        @relation("CommissionDepartment", fields: [departmentId], references: [id])
  entryType        CommissionEntry    @default(EARNING)
  receiverUserId   String?
  receiverUser     User?              @relation(fields: [receiverUserId], references: [id])
  receiverRole     CommissionRole
  amount           Decimal            @db.Decimal(10, 2)
  ratio            Decimal            @db.Decimal(5, 2)
  status           CommissionStatus   @default(PENDING)
  periodId         String?
  period           SettlementPeriod?  @relation(fields: [periodId], references: [id])
  originalRecordId String?
  originalRecord   CommissionRecord?  @relation("CommissionReversals", fields: [originalRecordId], references: [id])
  reversals        CommissionRecord[] @relation("CommissionReversals")
  remark           String?
  createdAt        DateTime           @default(now())
  settledAt        DateTime?

  @@index([membershipId])
  @@index([departmentId])
  @@index([status, periodId])
}

model SettlementPeriod {
  id             String             @id @default(cuid())
  startDate      DateTime
  endDate        DateTime
  totalFee       Decimal            @default(0) @db.Decimal(12, 2)
  totalRefundFee Decimal            @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal            @default(0) @db.Decimal(12, 2)
  recordCount    Int                @default(0)
  status         PeriodStatus       @default(OPEN)
  settledBy      String?
  settledAt      DateTime?
  remark         String?
  createdAt      DateTime           @default(now())
  records        CommissionRecord[]

  @@index([status, endDate])
}

model InvestmentProduct {
  id              String                  @id @default(cuid())
  productNo       String                  @unique
  name            String
  productType     String?
  riskLevel       RiskTolerance?
  minAmount       Decimal?                @db.Decimal(12, 2)
  expectedStartAt DateTime?
  expectedEndAt   DateTime?
  status          InvestmentProductStatus @default(DRAFT)
  remark          String?
  createdBy       String
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  investments     CustomerInvestment[]
  yieldPeriods    ProductYieldPeriod[]
  profitRecords   CustomerProfitRecord[]

  @@index([status])
  @@index([productNo])
}

model CustomerInvestment {
  id                     String                   @id @default(cuid())
  investmentNo           String                   @unique
  customerId             String
  customer               Customer                 @relation(fields: [customerId], references: [id])
  productId              String
  product                InvestmentProduct        @relation(fields: [productId], references: [id])
  amount                 Decimal                  @db.Decimal(12, 2)
  investedAt             DateTime
  status                 CustomerInvestmentStatus @default(ACTIVE)
  contractedBy           String?
  contractedEmployeeNo   String?
  contractedDepartmentId String?
  createdBy              String
  createdEmployeeNo      String?
  createdDepartmentId    String?
  remark                 String?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  profitRecords          CustomerProfitRecord[]

  @@index([customerId])
  @@index([productId, status])
  @@index([contractedEmployeeNo])
}

model ProductYieldPeriod {
  id            String                 @id @default(cuid())
  productId     String
  product       InvestmentProduct      @relation(fields: [productId], references: [id])
  periodStart   DateTime
  periodEnd     DateTime
  totalProfit   Decimal                @db.Decimal(12, 2)
  status        ProductYieldStatus     @default(DRAFT)
  confirmedBy   String?
  confirmedAt   DateTime?
  remark        String?
  createdBy     String
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  profitRecords CustomerProfitRecord[]

  @@unique([productId, periodStart, periodEnd])
  @@index([status])
}

model CustomerProfitRecord {
  id                   String               @id @default(cuid())
  customerId           String
  customer             Customer             @relation(fields: [customerId], references: [id])
  investmentId         String
  investment           CustomerInvestment   @relation(fields: [investmentId], references: [id])
  productId            String
  product              InvestmentProduct    @relation(fields: [productId], references: [id])
  yieldPeriodId        String
  yieldPeriod          ProductYieldPeriod   @relation(fields: [yieldPeriodId], references: [id])
  principalAmount      Decimal              @db.Decimal(12, 2)
  investmentShareRatio Decimal              @db.Decimal(12, 8)
  profitAmount         Decimal              @db.Decimal(12, 2)
  customerAmount       Decimal              @db.Decimal(12, 2)
  ratioSnapshot        Json
  status               CustomerProfitStatus @default(GENERATED)
  settledAt            DateTime?
  createdAt            DateTime             @default(now())
  shareRecords         ProfitShareRecord[]

  @@unique([investmentId, yieldPeriodId])
  @@index([customerId, createdAt])
  @@index([productId])
  @@index([status])
}

model ProfitShareConfig {
  id                  String                  @id @default(cuid())
  customerRatio       Decimal                 @db.Decimal(5, 2)
  departmentRatio     Decimal                 @db.Decimal(5, 2)
  contractedUserRatio Decimal                 @db.Decimal(5, 2)
  createdUserRatio    Decimal                 @db.Decimal(5, 2)
  companyRatio        Decimal                 @db.Decimal(5, 2)
  effectiveFrom       DateTime
  status              ProfitShareConfigStatus @default(ACTIVE)
  remark              String?
  createdBy           String
  createdAt           DateTime                @default(now())

  @@index([status, effectiveFrom])
}

model ProfitShareRecord {
  id             String                  @id @default(cuid())
  profitRecordId String
  profitRecord   CustomerProfitRecord    @relation(fields: [profitRecordId], references: [id])
  receiverType   ProfitShareReceiverType
  receiverId     String?
  receiverNo     String?
  ratio          Decimal                 @db.Decimal(5, 2)
  amount         Decimal                 @db.Decimal(12, 2)
  status         CustomerProfitStatus    @default(GENERATED)
  createdAt      DateTime                @default(now())
  settledAt      DateTime?

  @@index([profitRecordId])
  @@index([receiverType, receiverNo])
  @@index([status])
}

model SchedulerLog {
  id           String          @id @default(cuid())
  taskName     String
  status       SchedulerStatus
  affectedRows Int             @default(0)
  errorMessage String?
  executedAt   DateTime        @default(now())

  @@index([taskName, executedAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  action     String
  entityType String
  entityId   String
  operatorId String
  before     Json?
  after      Json?
  ip         String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([operatorId, createdAt])
}
